<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- .NET -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.18.7" />
        <!-- EF Core -->
        <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
        <!-- FluentMigrator -->
        <PackageVersion Include="FluentMigrator" Version="8.0.1" />
        <PackageVersion Include="FluentMigrator.Runner.Core" Version="8.0.1" />
        <PackageVersion Include="FluentMigrator.Runner.MySql" Version="8.0.1" />
        <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
        <!-- Database -->
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageVersion Include="MySqlConnector" Version="2.6.2" />
        <!-- Testing -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
        <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Testcontainers.MariaDb" Version="4.16.0" />
    </ItemGroup>
</Project>

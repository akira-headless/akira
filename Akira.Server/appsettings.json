{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "FluentMigrator": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SqlitePath": "/app/config/akira.db",
    "Port": 3306
  },
  "Library": {
    "SyncInterval": "00:30:00"
  },
  "Arr": {
    "Instances": []
  },
  "Probing": {
    "FfprobePath": "ffprobe",
    "Timeout": "00:02:00",
    "Interval": "00:02:00",
    "RescanInterval": "00:30:00",
    "MaxConcurrency": 2,
    "BatchSize": 25
  },
  "Auth": {
    "PairingLifetime": "00:10:00",
    "ProfileSessionLifetime": "12:00:00",
    "PinMaxAttempts": 5,
    "PinLockout": "00:05:00",
    "PairingStartsPerMinute": 10,
    "AnonymousRequestsPerMinute": 60
  },
  "Playback": {
    "PlayedThreshold": 0.9,
    "MinimumResume": "00:01:00",
    "ClientPathMappings": [],
    "Languages": {
      "Subtitles": "",
      "Audio": "",
      "SubtitleMode": null,
      "PreferOriginalLanguage": null
    }
  },
  "Events": {
    "Retention": "7.00:00:00"
  },
  "Subtitles": {
    "OpenSubtitles": {
      "Url": "https://api.opensubtitles.com/api/v1",
      "ApiKey": "",
      "Username": "",
      "Password": ""
    },
    "Lingarr": {
      "Url": "",
      "ApiKey": "",
      "PathMappings": []
    },
    "PollInterval": "00:00:05"
  }
}

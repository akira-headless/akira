<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Akira.Application\Akira.Application.csproj" />
        <ProjectReference Include="..\Akira.Core\Akira.Core.csproj" />
        <ProjectReference Include="..\Akira.Infrastructure\Akira.Infrastructure.csproj" />
        <ProjectReference Include="..\Akira.Migrations\Akira.Migrations.csproj" />
    </ItemGroup>

</Project>

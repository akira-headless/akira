{
    "name": "akira.web",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node scripts/api-types.mjs --check && vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "api-types": "node scripts/api-types.mjs",
        "preview": "vite preview"
    },
    "dependencies": {
        "pinia": "^4.1.0",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "openapi-typescript": "7.13.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vue-tsc": "3.3.11"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
